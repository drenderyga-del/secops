# Container image and database
SECPIPE_IMAGE=registry.example.com/scanops/scanops:v1.3.8
POSTGRES_PASSWORD=change-me
TZ=Europe/Moscow
LOG_LEVEL=INFO

# API and UI authentication
PIPE_BEARER_TOKEN=change-me
# Stable encryption key for credentials configured in the Integrations UI.
# Generate once with `openssl rand -hex 32`, store it as a protected secret,
# and keep the exact same value across every restart and every service.
# Changing it makes credentials already stored in the database unreadable.
INTEGRATION_CREDENTIALS_KEY=change-me-too
UI_AUTH_USERNAME=secpipe
UI_AUTH_PASSWORD=change-me
SECPIPE_PUBLIC_URL=http://localhost:8081
# Timeout for operator-triggered connector checks. Keep the production default.
INTEGRATION_TEST_TIMEOUT_SECONDS=10

# GitLab
# Connection tests require authentication and access to at least one project.
# Config Guard CI Lint is a separate project-scoped capability.
GITLAB_API_URL=https://gitlab.example.com/api/v4
GITLAB_PAT=
GITLAB=
# JSON array for multiple GitLab instances:
# [{"host":"gitlab.example.com","api_url":"https://gitlab.example.com/api/v4","token":"..."}]
GITLAB_INSTANCES=[]

# Pipeline polling and retention
PIPELINE_POLL_INTERVAL_SECONDS=300
PIPELINE_POLL_BATCH_SIZE=10
PIPELINE_MAX_AGE_SECONDS=86400
SECPIPE_RETENTION_DAYS=365

# Notifications
# Configure Mattermost here or in the Integrations UI. SMTP is an optional
# second channel. When neither env channel is set, release preflight warns and
# the operator must verify a UI-managed Mattermost connection after startup.
MATTERMOST_WEBHOOK_URL=
MATTERMOST_ALERT_ICON_URL=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_USE_TLS=true
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
SECPIPE_JOB_LONG_ALERT_ENABLED=true
SECPIPE_JOB_LONG_ALERT_MINUTES=45
SECPIPE_JOB_ALERT_INTERVAL_SECONDS=300
SECPIPE_JOB_ALERT_RESEND_MINUTES=0
# Comma-separated defaults, exclusions, and an optional regex override.
SECPIPE_JOB_LONG_ALERT_NAMES=semgrep_scan,sca_scan,gitleaks_scan,trivy_scan,asoc_scan,mobsf_scan
SECPIPE_JOB_LONG_ALERT_EXCLUDE_NAMES=ptai_scan
SECPIPE_JOB_LONG_ALERT_REGEX=

# Audit digest
AUDIT_DIGEST_ENABLED=true
AUDIT_DIGEST_INTERVAL_DAYS=7
AUDIT_SECURITY_JOB_NAMES=ptai_async_scan,semgrep_scan,sca_scan,gitleaks_scan,trivy_scan,asoc_scan,mobsf_scan

# Config Scan
CONFIG_SCAN_ENABLED=true
CONFIG_SCAN_RUN_BACKGROUND_SCHEDULER=true
CONFIG_SCAN_FULL_PRODUCT_INTERVAL_SECONDS=2592000
CONFIG_SCAN_FULL_PRODUCT_ON_START=false
CONFIG_SCAN_REPORTS_DIR=/data/config_scan_reports

# ASOC / Vampy
# This is the API URL. Links in alerts use the same URL without the trailing /api.
HEXWAY_URL=https://vampy.example.com/api
HEXWAY_TOKEN=
HEXWAY_SPACE_ID=
HEXWAY_TIMEOUT=30
ASOC_VERIFY_SSL=true
# Pipeline worker refreshes ASOC product cards on this cadence; 0 disables it.
# A scheduled run never archives cards: any removal waits for Synchronize ASOC in Products.
ASOC_PRODUCT_SYNC_INTERVAL_MINUTES=60
# Products marks a card overdue when its GitLab group is not synced after this many days.
PRODUCT_SYNC_GRACE_DAYS=3
# One dedicated ASOC product for repositories created by manual IaC scans.
IAC_HEXWAY_PRODUCT_ID=

# Direct PT AI engine status (optional)
PTAI_URL=
PTAI_TOKEN=
PTAI_PROJECT_PREFIX=vampy-asoc-
# Optional PT AI web deep-link. Available placeholders:
# {base_url}, {project_id}, {branch_id}, {scan_result_id}.
# Empty = official API result URL under PTAI_URL.
PTAI_RESULT_URL_TEMPLATE=
PTAI_VERIFY_SSL=true
PTAI_TIMEOUT=30

# PT AI queue alerts
PTAI_QUEUE_ALERT_ENABLED=true
PTAI_QUEUE_ALERT_THRESHOLD=10
PTAI_QUEUE_ALERT_INTERVAL_SECONDS=300
PTAI_QUEUE_ALERT_RESEND_MINUTES=60
PTAI_QUEUE_ALERT_STAGES=Enqueued,Queued
PTAI_QUEUE_PROJECT_LIMIT=500
PTAI_QUEUE_BRANCH_LIMIT=20

# PT AI asynchronous scan status and hung-scan alerts
PTAI_SCAN_STATUS_ALERT_ENABLED=true
PTAI_SCAN_STATUS_POLL_INTERVAL_SECONDS=300
PTAI_SCAN_HUNG_ALERT_MINUTES=120
PTAI_SCAN_STATUS_BATCH_SIZE=50

# IaC worker
IAC_WORKER_ENABLED=true
IAC_WORKER_INTERVAL_SECONDS=10
IAC_GITLAB_REQUEST_TIMEOUT=30
IAC_CLONE_TIMEOUT_SECONDS=600
IAC_CHECKOV_TIMEOUT_SECONDS=900
IAC_WORK_DIR=/tmp
IAC_REPORTS_DIR=/data/iac_reports

# ASOC enrichment (optional)
ASOC_ENRICH_ENABLED=false
ASOC_ENRICH_RAISE_SEVERITY=false
EPSS_MIN_SCORE=0.5
KEV_FEED_URL=
EPSS_FEED_URL=

# Health checks
HEALTH_WORKER_STALE_SECONDS=1800
HEALTH_PIPELINE_POLL_STALE_SECONDS=900
HEALTH_EXPECTED_WORKERS=pipeline_worker,iac_worker
# Mark Live Execution Topology stale when no new execution arrives for 24h.
TOPOLOGY_SIGNAL_STALE_SECONDS=86400

# Optional exact hostnames of product directories linked from ASOC descriptions.
ASOC_PRODUCT_REFERENCE_HOSTS=

# Dedicated opt-in external-agent credential (minimum 32 characters).
# Must differ from PIPE_BEARER_TOKEN; never grant operator or CI privileges.
SCANOPS_AGENT_API_TOKEN=

# Optional comma-separated top-level namespaces whose second group is a product.
# Empty uses the first namespace segment everywhere; no organization defaults.
PRODUCT_NESTED_NAMESPACES=

# Optional mapping of GitLab hostnames to existing ASOC repository slug prefixes.
# Default uses the complete hostname; keep compatibility mappings private.
ASOC_GITLAB_HOST_PREFIXES={}
