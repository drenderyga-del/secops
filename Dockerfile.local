# Local development image.
#
# Pin the official Python slim tag instead of using floating python:3.12-slim,
# so local rebuilds do not depend on Docker Hub tag movement.
ARG BASE_IMAGE=python:3.12.11-slim-bookworm
FROM node:22.13-alpine AS signal-control-build

WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build


FROM ${BASE_IMAGE}

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
COPY --from=signal-control-build /app/static/next ./app/static/next

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
